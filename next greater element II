class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        vector<int> ans(nums.size(),-1);   //initializes the vector with -1
        stack<int> temp;
        for(int i=2*nums.size()-1;i>=0;i--){     //cz hume circular traversal krna allowed hai yaha toh 2*size allows you to make the duplicate set of the array without actually duplicating it
            int currindex= i%nums.size();    //to get the valid index i=2*3-1=5%3=2 (a vaild index for array with 3 elements)
            while(!temp.empty()){
                if(nums[temp.top()]>nums[currindex]){     //normal next greater element working
                    ans[currindex]=nums[temp.top()];
                    break;
                }
                temp.pop();
            }
            temp.push(currindex);
        }
        return ans;
    }
};
//first iteration of array just prepares the stack, send iteration actually makes the changes
